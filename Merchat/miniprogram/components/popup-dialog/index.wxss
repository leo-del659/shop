/* 遮罩层 */
.pd-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  transition: opacity 0.25s ease;
}
.pd-mask--enter { opacity: 1; }
.pd-mask--leave { opacity: 0; }

/* 居中弹窗模式（默认） */
.pd-dialog {
  width: 600rpx;
  max-width: 92vw;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  transform: translateY(0) scale(1);
  opacity: 1;
  transition: transform 0.2s ease, opacity 0.2s ease;
}
.pd-dialog--enter { transform: translateY(0) scale(1); opacity: 1; }
.pd-dialog--leave { transform: translateY(40rpx) scale(0.96); opacity: 0; }

.pd-header {
  position: relative;
  text-align: center;
  margin-bottom: 28rpx;
}
.pd-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}
.pd-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 10rpx;
  line-height: 1.4;
}
.pd-close {
  position: absolute;
  right: 0;
  top: -4rpx;
  font-size: 44rpx;
  color: var(--muted);
  line-height: 1;
  padding: 8rpx;
}

.pd-body {
  font-size: 28rpx;
  color: var(--text);
}

.pd-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

/* 底部弹出面板模式（mode=bottom） */
.pd-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}
.pd-sheet--enter { transform: translateY(0); }
.pd-sheet--leave { transform: translateY(100%); }

/* 关闭按钮独占一排 */
.pd-sheet-close-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 12rpx 24rpx 4rpx;
  flex-shrink: 0;
}
.pd-sheet-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--text);
}

/* 可滚动内容区 */
.pd-sheet-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.pd-sheet-content {
  padding: 0 32rpx 24rpx;
}

/* 底部固定操作栏 */
.pd-sheet-footer {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
}

/* 按钮（两种模式共用） */
.pd-btn {
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.15s ease;
  white-space: nowrap;
}
.pd-btn--block { width: 100%; }
.pd-btn--ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--line-strong);
}
.pd-btn--primary {
  background: linear-gradient(135deg, var(--brand), var(--brand));
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(59, 111, 224, 0.25);
}
/* 底部面板模式：主按钮改为橙色 + 金额合并展示 */
.pd-sheet .pd-btn--primary {
  background: linear-gradient(135deg, var(--warning), var(--warning));
  box-shadow: 0 4rpx 14rpx rgba(255, 87, 34, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 44rpx;
}
.pd-sheet-pay-amount {
  font-size: 30rpx;
  font-weight: 700;
}
.pd-btn.is-disabled {
  opacity: 0.55;
}
