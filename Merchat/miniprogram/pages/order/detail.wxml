<view class="page" wx:if="{{bill}}">
  <!-- 订单状态头部（默认系统导航承载标题，此处突出状态） -->
  <view class="status-head">
    <view class="tag {{bill.statusCls}}">{{bill.statusLabel}}</view>
    <view class="sh-no">订单号：{{bill.billNo}}</view>
  </view>

  <!-- 账单基本信息 -->
  <view class="info-card">
    <view class="info-header">
      <view class="info-no">{{bill.billNo}}</view>
      <view class="info-pay paid">{{bill.payStatusText}}</view>
    </view>

    <view class="info-row" wx:if="{{bill.merchantName && bill.merchantName !== '-'}}">
      <text class="label">商户名称</text>
      <text class="value">{{bill.merchantName}}</text>
    </view>

    <view class="info-row" wx:if="{{bill.merchantContact}}">
      <text class="label">收件人</text>
      <text class="value">{{bill.merchantContact}}</text>
    </view>

    <view class="info-row" wx:if="{{bill.merchantPhone}}">
      <text class="label">联系电话</text>
      <text class="value">{{bill.merchantPhone}}</text>
    </view>

    <view class="info-row" wx:if="{{bill.merchantAddress}}">
      <text class="label">收货地址</text>
      <text class="value">{{bill.merchantAddress}}</text>
    </view>

    <view class="info-row" wx:if="{{bill.deliveryTime}}">
      <text class="label">交付时间</text>
      <text class="value">{{bill.deliveryTime}}</text>
    </view>

    <view class="info-row">
      <text class="label">下单时间</text>
      <text class="value">{{bill.createTimeFormatted}}</text>
    </view>

    <view class="info-row">
      <text class="label">订单状态</text>
      <text class="value highlight {{bill.statusCls}}">{{bill.statusLabel}}</text>
    </view>

    <view class="info-row" wx:if="{{bill.rejectReason}}">
      <text class="label">拒单理由</text>
      <text class="value remark">{{bill.rejectReason}}</text>
    </view>

    <view class="info-row" wx:if="{{bill.remark}}">
      <text class="label">备注</text>
      <text class="value remark">{{bill.remark}}</text>
    </view>
  </view>

  <!-- 商品明细 -->
  <view class="product-card">
    <view class="card-title">商品明细</view>
    <view wx:for="{{bill.items}}" wx:key="name" class="product-item">
      <view class="product-name">{{item.name}}</view>
      <view class="product-qty-inline">×{{item.qty}}</view>
    </view>
    <view class="total-row">
      <text>合计金额</text>
      <text class="total-amount">{{bill.totalText}}</text>
    </view>
  </view>

  <!-- 物流跟踪（按订单状态动态显示） -->
  <view class="logistics-card" wx:if="{{bill.logistics && bill.logistics.length > 0}}">
    <view class="card-title">物流跟踪</view>
    <view wx:for="{{bill.logistics}}" wx:key="text" class="logistics-item">
      <view class="dot-wrap">
        <view class="dot {{item.current ? 'current' : (item.active ? 'active' : 'inactive')}}"></view>
        <view wx:if="{{index < bill.logistics.length - 1}}" class="logistics-line {{item.active ? 'active' : ''}}"></view>
      </view>
      <view class="logistics-content">
        <view class="logistics-text {{item.current ? 'current' : ''}}">{{item.text}}</view>
        <view class="logistics-time" wx:if="{{item.time}}">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <block wx:if="{{bill.canAccept}}">
      <view class="action-btn btn-outline" style="flex:1;" bindtap="goBack">返回</view>
      <view class="action-btn btn-reject" style="flex:1;" catchtap="action" data-op="reject" data-id="{{bill.id}}">拒单</view>
      <view class="action-btn btn-accept" style="flex:1;" catchtap="action" data-op="accept" data-id="{{bill.id}}">接单</view>
    </block>
    <block wx:elif="{{bill.canShip}}">
      <view class="action-btn btn-outline" style="flex:1;" bindtap="goBack">返回</view>
      <view class="action-btn btn-ship" style="flex:1;" catchtap="action" data-op="ship" data-id="{{bill.id}}">确认发货</view>
    </block>
    <block wx:elif="{{bill.isShipping}}">
      <view class="action-btn btn-outline" style="flex:1;" bindtap="goBack">配送中</view>
    </block>
    <block wx:elif="{{bill.isCompleted}}">
      <view class="action-btn btn-outline" style="flex:1;" bindtap="goBack">已完成</view>
    </block>
    <block wx:elif="{{bill.isCancelled}}">
      <view class="action-btn btn-outline" style="flex:1;" bindtap="goBack">已取消</view>
    </block>
    <block wx:else>
      <view class="action-btn btn-outline" style="flex:1;" bindtap="goBack">返回</view>
    </block>
  </view>
</view>

<!-- 空态：未加载到数据时显示 -->
<view wx:if="{{!bill}}" class="page-empty">
  <view class="empty-text">订单加载中...</view>
</view>
