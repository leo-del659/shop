page { background: var(--bg); }

.page {
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* 统计 */
.stats {
  display: flex;
  margin: 16rpx 12rpx 0;
  gap: 10rpx;
}
.stat-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.stat-n { display: block; font-size: 40rpx; font-weight: 800; line-height: 1.2; }
.stat-n.blue { color: var(--info); }
.stat-n.gold { color: var(--warning); }
.stat-n.purple { color: var(--purple); }
.stat-n.green { color: var(--brand); }
.stat-n.red { color: var(--danger); }
.stat-l { display: block; font-size: 21rpx; color: var(--muted); margin-top: 6rpx; }

/* 标签栏 + 清空按钮 */
.tags-bar {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
}
.tags {
  display: flex;
  white-space: nowrap;
  padding: 0 12rpx 8rpx;
  flex: 1;
}
.tag {
  display: inline-block;
  font-size: 25rpx;
  color: var(--muted);
  background: #fff;
  border: 1rpx solid var(--line-strong);
  border-radius: 28rpx;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
}
.tag.active {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}

/* 列表区域 */
.list-area {
  padding: 4rpx 16rpx;
}

/* 订单行 - 无卡片，紧凑无拉伸 */
.card {
  background: transparent;
  border-radius: 0;
  padding: 14rpx 0;
  margin-bottom: 0;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  border-bottom: 1rpx solid var(--line);
}
.card:last-child { border-bottom: none; }
.card-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.card-no { font-size: 27rpx; font-weight: 700; color: var(--brand-dark); }
.card-time { font-size: 23rpx; color: var(--muted); }
.card-mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.goods-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 16rpx;
}
.goods-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: var(--line);
  flex-shrink: 0;
}
.goods-thumb--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.goods-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.card-party { font-size: 22rpx; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-goods { font-size: 26rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
.card-qty { font-size: 23rpx; color: var(--muted); }
.card-money { font-size: 34rpx; font-weight: 800; color: var(--brand); flex-shrink: 0; }
.card-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 4rpx;
}

/* 状态徽章 */
.badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
}
.badge.pending { background: var(--warning-bg); color: var(--warning-deep); }
.badge.shipping { background: var(--info-bg); color: var(--info); }
.badge.completed { background: var(--brand-light); color: var(--brand-dark); }
.badge.cancelled { background: var(--danger-bg); color: var(--danger); }

/* 按钮 */
.btns { display: flex; gap: 10rpx; }
.btn {
  font-size: 23rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
}
.btn-g { background: var(--brand); color: #fff; }
.btn-r { background: #fff; color: var(--danger); border: 1.5rpx solid var(--danger); }
.btn-b { background: var(--info); color: #fff; }
.btn-w { background: #fff; color: var(--info); border: 1.5rpx solid var(--info); }

/* 空状态 */
.empty-box {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--muted);
}
.empty-txt { display: block; font-size: 30rpx; }
.empty-sub { display: block; font-size: 25rpx; color: var(--muted); margin-top: 10rpx; }
