<view class="addr-edit">
  <view class="form">
    <view class="form-row">
      <view class="form-label">收件人</view>
      <input class="form-input" placeholder="请输入收件人姓名" value="{{name}}" bindinput="onInputName" maxlength="20" />
    </view>
    <view class="form-row">
      <view class="form-label">手机号</view>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{mobile}}" bindinput="onInputMobile" />
    </view>
    <view class="form-row">
      <view class="form-label">所在地区</view>
      <picker mode="region" value="{{region}}" bindchange="onPickRegion" class="form-picker">
        <view class="form-picker-text">
          <text wx:if="{{province}}">{{province}} {{city}} {{district}}</text>
          <text wx:else class="placeholder">请选择省/市/区</text>
        </view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">详细地址</view>
      <textarea class="form-textarea" placeholder="街道、楼栋、门牌号等" value="{{detailAddr}}" bindinput="onInputAddr" maxlength="100" auto-height></textarea>
    </view>
    <view class="form-row form-row--switch" bindtap="onToggleDefault">
      <view class="form-label">设为默认地址</view>
      <switch checked="{{isDefault === 1}}" disabled color="#3b6fe0"></switch>
    </view>
  </view>

  <view class="footer">
    <view class="footer-btn primary {{saving ? 'is-disabled' : ''}}" bindtap="onSave">
      <text wx:if="{{saving}}">保存中…</text>
      <text wx:else>保存地址</text>
    </view>
  </view>
</view>
