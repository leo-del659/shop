<view class="home">
  <!-- 顶部：品牌栏 -->
  <view class="top-bar">
    <view class="brand">
      <text class="brand-name">集邻生活</text>
    </view>
    <view class="brand-sub">新鲜直达 · 邻里优选</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-wrap">
    <view class="search-bar" bindtap="goSearch">
      <van-icon name="scan" class="search-scan" />
      <text class="search-placeholder">搜索商品</text>
      <view class="search-btn" catchtap="goSearch">搜索</view>
    </view>
  </view>

  <!-- 分类入口：10 宫格 -->
  <view class="cat-panel" wx:if="{{tabs.length}}">
    <view wx:for="{{tabs}}" wx:key="id" class="cat-card" data-id="{{item.id}}" bindtap="onTab">
      <view class="cat-circle">
        <image wx:if="{{item.icon}}" class="cat-icon" src="{{item.icon}}" mode="aspectFill" />
        <view wx:else class="cat-icon cat-icon-default">{{item.emoji}}</view>
      </view>
      <text class="cat-name">{{item.categoryName}}</text>
    </view>
  </view>

  <!-- 公告条 -->
  <view class="notice-bar" wx:if="{{notice}}">
    <van-icon name="volume-o" class="notice-icon" />
    <text class="notice-text">{{notice}}</text>
  </view>

  <view wx:if="{{loading}}" class="empty-wrap">加载中...</view>

  <!-- 全部商品 -->
  <view class="section" wx:if="{{!loading && allGoods.length}}">
    <view class="section-head">
      <view class="section-title">
        <van-icon name="like" color="#fa3534" size="32rpx" />
        <text>猜你喜欢</text>
      </view>
    </view>
    <view class="goods-grid">
      <view wx:for="{{allGoods}}" wx:key="id" class="goods-cell">
        <goods-card goods="{{item}}" quantity="{{item._qty || 0}}" bind:tap="goDetail" bind:openSku="onOpenSku" bind:incCart="onIncCart" bind:decCart="onDecCart" />
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !allGoods.length}}" class="empty-wrap">暂无商品数据</view>
</view>

<!-- SKU 规格选择弹窗（首页/详情页共用组件） -->
<sku-popup
  visible="{{showSku}}"
  goods="{{skuGoods}}"
  action="{{skuAction}}"
  initialQty="{{1}}"
  bind:close="closeSku"
  bind:confirm="onSkuConfirm"
/>
