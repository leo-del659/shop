<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar-item {{item.activeCls}}"
    data-index="{{index}}"
    catchtap="switchTab"
    hover-class="tab-bar-item-hover"
    hover-stay-time="100"
  >
    <view class="tab-icon">{{item.icon}}</view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
