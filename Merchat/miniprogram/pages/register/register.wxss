/* 注册页：蓝白玻璃风 —— 整页蓝渐变 + 毛玻璃卡片 */
page {
  background: transparent;
}

.register {
  min-height: 100vh;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  /* 整页蓝渐变，毛玻璃卡片透出蓝调 */
  background: linear-gradient(180deg, #2f5fcf 0%, #4f82e8 42%, #bcd2f7 72%, #eaf1fd 100%);
}

/* 顶部品牌区（去掉独立蓝底，由页面渐变承载；保留白色光环装饰） */
.header {
  position: relative;
  padding: 80rpx 40rpx 120rpx;
  overflow: hidden;
}
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
}
.decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
}
.decor-1 {
  width: 320rpx;
  height: 320rpx;
  top: -80rpx;
  right: -80rpx;
}
.decor-2 {
  width: 220rpx;
  height: 220rpx;
  bottom: 20rpx;
  left: -60rpx;
}
.logo-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.logo-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
}
.logo-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.logo-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 2rpx;
}

/* 注册卡片：毛玻璃面板 */
.card {
  position: relative;
  z-index: 2;
  margin: -80rpx 40rpx 0;
  background: rgba(255, 255, 255, 0.55);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 44rpx;
  padding: 48rpx 40rpx 56rpx;
  box-shadow: 0 24rpx 60rpx rgba(43, 87, 190, 0.22);
}
.card-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}
.card-sub {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 12rpx;
  margin-bottom: 36rpx;
}

/* 输入行：玻璃蓝下划线 */
.input-group {
  margin-top: 16rpx;
}
.input-row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid rgba(59, 111, 224, 0.18);
  transition: border-color 0.2s ease;
}
.input-row:focus-within {
  border-bottom-color: var(--brand);
}
.input-icon {
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 32rpx;
}
.native-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  min-width: 0;
}
.native-input::placeholder {
  color: var(--muted);
}

/* 验证码按钮：玻璃描边胶囊 */
.code-btn-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
}
.code-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-dark);
  padding: 12rpx 22rpx;
  border: 1.5rpx solid var(--brand);
  border-radius: 32rpx;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.5);
}
.code-btn:active {
  opacity: 0.7;
}
.code-btn-disabled {
  color: var(--muted);
  border-color: var(--line-strong);
  background: rgba(255, 255, 255, 0.3);
}

/* 错误提示 */
.error-wrap {
  min-height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
.error {
  font-size: 24rpx;
  color: var(--warning);
  text-align: center;
}

/* 注册按钮：玻璃蓝 */
.reg-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #3b6fe0 0%, #5b8def 100%) !important;
  color: #fff !important;
  border: 1rpx solid rgba(255, 255, 255, 0.35) !important;
  border-radius: 48rpx !important;
  box-shadow: 0 16rpx 40rpx rgba(43, 87, 190, 0.32);
  font-size: 32rpx !important;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.reg-btn::after {
  border: none;
}
.reg-btn:active {
  opacity: 0.92;
  transform: translateY(2rpx);
}
.reg-btn[disabled] {
  opacity: 0.6;
  color: #fff !important;
  background: linear-gradient(135deg, #3b6fe0 0%, #5b8def 100%) !important;
}

/* 底部返回登录 */
.form-footer {
  margin-top: 32rpx;
  text-align: center;
}
.back-login-link {
  font-size: 26rpx;
  color: var(--brand-dark);
  padding: 8rpx 16rpx;
  font-weight: 500;
}
.back-login-link:active {
  opacity: 0.7;
}
