/* 我的 · 设计令牌引用自 app.wxss */
.profile-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* 浅色品牌页头（与用户端「我的」同款） */
.hero {
  position: relative;
  padding: 0 30rpx 40rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 260rpx;
  background: var(--header-gradient);
  border-radius: 0 0 60rpx 60rpx;
}
.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 48rpx;
}
.avatar,
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(59, 111, 224, 0.12);
  background: #ffffff;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar {
  color: var(--brand-dark);
  font-size: 48rpx;
  font-weight: 700;
}
.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-sub {
  font-size: 24rpx;
  color: var(--muted);
}
.hero-phone {
  font-size: 24rpx;
  color: var(--muted);
}
.setting-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 32rpx;
}
.btn-press {
  opacity: 0.85;
}

/* 经营统计 */
.stat-block {
  display: flex;
  align-items: stretch;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 8rpx 0;
  border-radius: 16rpx;
}
.stat-hover {
  opacity: 0.7;
}
.stat-divider {
  width: 1rpx;
  background: var(--line);
  margin: 8rpx 0;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.2;
}
.stat-num.warn {
  color: var(--danger);
}
.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 常用功能 */
.menu-section {
  padding: 24rpx;
}
.menu-section .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.menu-list {
  background: var(--surface-variant);
  border-radius: 16rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-hover {
  background: #ffffff;
}
.menu-item .icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-item .icon.icon-brand { background: var(--brand-light); }
.menu-item .icon.icon-blue { background: var(--info-bg); }
.menu-item .icon.icon-gold { background: var(--warning-bg); }
.menu-item .icon.icon-purple { background: var(--purple-bg); }
.menu-item .content {
  flex: 1;
  min-width: 0;
}
.menu-item .content .title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}
.menu-item .content .desc {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.menu-item .arrow {
  color: var(--muted);
  font-size: 30rpx;
  margin-left: 12rpx;
  font-weight: 300;
}

/* 退出登录 */
.logout-wrap {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.logout-btn {
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.logout-btn .logout-icon {
  font-size: 30rpx;
}

.page-pad-bottom {
  height: 40rpx;
}
