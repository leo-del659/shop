<view class="addr">
  <view wx:if="{{list.length === 0 && !showForm}}" class="empty muted">还没有收货地址，点击下方按钮新增</view>

  <view wx:for="{{list}}" wx:key="id" class="card" bind:tap="onPick" data-index="{{index}}">
    <view class="card-hd">
      <text class="name">{{item.name}}</text>
      <text class="mobile">{{item.mobile}}</text>
      <van-tag wx:if="{{item.isDefault === 1}}" type="primary" plain>默认</van-tag>
    </view>
    <view class="card-bd">{{item.fullAddress}}</view>
    <view class="card-ft" catch:tap="noop">
      <text class="op primary" data-index="{{index}}" bind:tap="onConfirm">确认</text>
      <text class="op" wx:if="{{item.isDefault !== 1}}" data-id="{{item.id}}" bind:tap="onSetDefault">设为默认</text>
      <text class="op" data-index="{{index}}" bind:tap="openEdit">编辑</text>
      <text class="op danger" data-id="{{item.id}}" bind:tap="onDelete">删除</text>
    </view>
  </view>

  <van-button wx:if="{{!showForm}}" type="primary" block bind:tap="openAdd" custom-class="add-btn">新增收货地址</van-button>

  <van-popup wx:if="{{showForm}}" show="{{showForm}}" position="bottom" bind:close="closeForm" custom-style="height:92%;">
    <view class="form">
      <view class="form-title">{{form.id ? '编辑地址' : '新增地址'}}</view>
      <van-cell-group border="{{false}}">
        <van-field label="收件人" placeholder="请输入收件人" value="{{form.name}}" data-field="name" bind:change="onField" />
        <van-field label="手机号" placeholder="请输入手机号" type="number" maxlength="11" value="{{form.mobile}}" data-field="mobile" bind:change="onField" />
        <van-field label="省份" placeholder="如：广东省" value="{{form.province}}" data-field="province" bind:change="onField" />
        <van-field label="城市" placeholder="如：深圳市" value="{{form.city}}" data-field="city" bind:change="onField" />
        <van-field label="区/县" placeholder="如：南山区" value="{{form.district}}" data-field="district" bind:change="onField" />
        <van-field label="详细地址" placeholder="街道、门牌号等" value="{{form.detailAddr}}" data-field="detailAddr" bind:change="onField" />
        <van-cell title="设为默认地址">
          <van-switch checked="{{form.isDefault === 1}}" bind:change="onDefault" />
        </van-cell>
      </van-cell-group>
      <view class="form-btns">
        <van-button bind:tap="closeForm">取消</van-button>
        <van-button type="primary" bind:tap="onSubmit">保存</van-button>
      </view>
    </view>
  </van-popup>
</view>
