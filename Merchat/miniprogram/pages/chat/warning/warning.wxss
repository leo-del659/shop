/* 复用聊天页样式（与买家聊天界面保持一致）
   注意：@import 相对当前文件所在目录解析，本文件在 pages/chat/warning/ 下，同级聊天页样式为 ../chat.wxss */
@import "../chat.wxss";

/* 系统消息头像 */
.msg-avatar-system {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: #fff7e6;
}

/* 库存预警气泡 */
.bubble-notice {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
}
.bubble-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.bubble-text {
  font-size: 27rpx;
  color: #3a4250;
  line-height: 1.55;
  white-space: pre-wrap;
}
.bubble-stock {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #f6a200;
}

/* 底部提示（系统通知不可回复） */
.chat-tip {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9aa3af;
  padding: 14rpx 0;
}
