.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f7f9;
}

/* 消息滚动区 */
.chat-scroll {
  flex: 1;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
}
.chat-empty {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
  font-size: 26rpx;
  color: #b0b3b8;
}

/* 消息行 */
.msg-row {
  margin-bottom: 28rpx;
}
.msg-row-self {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
/* 时间分隔 */
.msg-time {
  text-align: center;
  font-size: 22rpx;
  color: #b0b3b8;
  margin-bottom: 20rpx;
}
.msg-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.msg-row-self .msg-line {
  justify-content: flex-end;
}

/* 买家头像 */
.msg-avatar-wrap {
  flex-shrink: 0;
}
.msg-avatar {
  display: block;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eceff3;
}
.msg-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #3b6fe0;
  background: #eaf1fd;
}

/* 气泡 */
.bubble {
  max-width: 480rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
  border-radius: 18rpx;
}
.bubble-other {
  background: #fff;
  color: #1a1a1a;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.bubble-self {
  background: #3b6fe0;
  color: #fff;
  border-top-right-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(59, 111, 224, 0.25);
}

/* 底部输入栏 */
.chat-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  background: #f5f6f8;
  border-radius: 36rpx;
}
.chat-send {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #fff;
  background: #a9c2ec;
  border-radius: 36rpx;
}
.chat-send-active {
  background: #3b6fe0;
}
.chat-send:active {
  opacity: 0.85;
}
