.detail {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: 20rpx;
}
/* 详情卡片：毛玻璃面板（覆盖全局 .card 的白底） */
.detail .card {
  background: rgba(255, 255, 255, 0.74);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 6rpx 24rpx rgba(43, 87, 190, 0.10);
  border-radius: 20rpx;
}
.gallery {
  height: 420rpx;
  background: var(--surface-variant);
}
.gallery-img {
  width: 100%;
  height: 100%;
}
.gallery-emoji {
  font-size: 200rpx;
  text-align: center;
  line-height: 420rpx;
}
.d-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.d-name {
  font-size: 34rpx;
  font-weight: 700;
}
.d-cat {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.d-merchant {
  font-size: 24rpx;
  margin-top: 8rpx;
  color: var(--muted);
}
.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--brand-light);
  color: var(--brand);
}
.tag.disabled,
.tag.draft {
  background: var(--line);
  color: var(--muted);
}
.d-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
}
.d-price-label {
  font-size: 24rpx;
  color: var(--muted);
  align-self: center;
}
.d-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--danger);
}
.d-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}
.d-market {
  font-size: 24rpx;
}
.d-stock {
  font-size: 24rpx;
  margin-top: 10rpx;
}
.d-desc {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
  margin-top: 10rpx;
}

.info-card .info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
/* 销量行上方空出一排（与成本价之间留出视觉间隔） */
.info-row--gap {
  margin-top: 28rpx;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: var(--muted);
}
.info-val {
  font-size: 26rpx;
  font-weight: 600;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  /* 玻璃悬浮操作栏 */
  background: rgba(255, 255, 255, 0.72);
  border-top: 1rpx solid rgba(255, 255, 255, 0.7);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -6rpx 26rpx rgba(43, 87, 190, 0.10);
  z-index: 50;
}
.footer-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.footer-btn.primary {
  background: var(--brand);
  color: #fff;
}
.footer-btn.ghost {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--brand);
}

/* 信息卡片：成本价行 */
.info-val--cost {
  color: var(--brand);
  font-weight: 700;
}
.info-val-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 4rpx;
}


/* ============ 商品规格（多规格明细） ============ */
.spec-count {
  font-size: 24rpx;
  color: var(--muted);
}
.spec-table {
  margin-top: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
}
.spec-thead,
.spec-trow {
  display: flex;
  align-items: center;
}
.spec-thead {
  background: #fafbfc;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.spec-th {
  flex: 1;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}
.spec-th-name {
  flex: 1.3;
  text-align: left;
}
.spec-th-code {
  flex: 1;
}
.spec-trow {
  padding: 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.spec-trow:last-child {
  border-bottom: none;
}
.spec-td {
  flex: 1;
  font-size: 25rpx;
  color: var(--text);
  text-align: center;
}
.spec-td-name {
  flex: 1.3;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.spec-td-code {
  flex: 1;
  font-size: 22rpx;
  color: var(--muted);
}
.spec-td.warn {
  color: var(--warning);
}
.spec-td.danger {
  color: var(--danger);
}
.spec-sum {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}
