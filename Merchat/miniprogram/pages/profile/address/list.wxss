.addr-list { padding-bottom: 200rpx; }

.empty {
  padding: 200rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  filter: grayscale(0.4);
}
.empty-tip {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.row {
  margin: 20rpx 24rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.row.is-default { border-color: var(--brand); }

.r-main {
  flex: 1;
  min-width: 0;
}
.r-line1 {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.r-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}
.r-mobile {
  font-size: 26rpx;
  color: var(--text);
}
.r-default {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-light);
  color: var(--brand);
}
.r-line2 {
  font-size: 26rpx;
  color: var(--text);
  margin-top: 12rpx;
  line-height: 1.4;
}
.r-pick-hint {
  font-size: 22rpx;
  color: var(--brand);
  margin-top: 12rpx;
}

.r-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.r-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--surface-variant);
  color: var(--text);
  text-align: center;
}
.r-btn.danger { color: var(--danger); }

.add-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--brand);
  color: #fff;
  text-align: center;
  padding: 28rpx 0;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  font-size: 30rpx;
  z-index: 10;
}
