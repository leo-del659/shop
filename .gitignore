# ===================== 依赖（前端 + 小程序） =====================
node_modules/
**/node_modules/

# 小程序「构建 npm」的产物，开发者工具里重新点一下就能生成
miniprogram_npm/
**/miniprogram_npm/

# ===================== 构建产物 =====================
dist/
dist-ssr/
coverage/
**/.vite/
*.tsbuildinfo

# ===================== 本地环境配置 =====================
# 只忽略 .local 这一类本机文件，.env.development / .env.production 正常提交
.env.local
.env.*.local

# ===================== 日志 =====================
*.log
npm-debug.log*
Logs/
**/Logs/

# ===================== 编辑器 / IDE =====================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sw?

# ===================== 系统文件 =====================
.DS_Store
Thumbs.db

# ===================== 微信开发者工具私有配置 =====================
# 里面是本机相关设置，不同电脑不一样，没进仓库
project.private.config.json
**/project.private.config.json

# ===================== 本地备份 / 废弃代码 =====================
_code_bak*/
**/_code_bak*/

# ===================== .NET 构建产物 =====================
[Bb]in/
[Oo]bj/
.vs/
*.user
*.userprefs
*.cache

# ===================== 密钥 / 含机密的配置（不进仓库） =====================
# 后端 appsettings 里带 JWT 密钥、连接串等敏感信息，统一不提交；
# 仓库只保留 appsettings.example.json 模板，真实配置留在本地。
appsettings.json
appsettings.*.json
**/appsettings.json
**/appsettings.*.json

# 例外：脱敏模板要进仓库
!appsettings.example.json
!**/appsettings.example.json
