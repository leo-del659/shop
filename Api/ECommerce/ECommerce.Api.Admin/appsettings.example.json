{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "host": "http://localhost:6001",
  "Logs": {
    "Action_Log": "Logs",
    "Error_Log": "Logs/Error"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_A_STRONG_JWT_SECRET",
    "Issuer": "ECommerce",
    "Audience": "Commerce",
    "ExpiresMinutes": 480
  },
  "check_login": "",
  "RabbitMQ": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "community.order",
    "DeadLetterExchange": "community.order.dlx",
    "Prefetch": 20,
    "AutoCancelDelayMinutes": 30,
    "LowStockThreshold": 10
  },
  "WeChatPay": {
    "Enabled": false,
    "AppId": "YOUR_WECHAT_APPID"
  },
  "Resilience": {
    "Enabled": true,
    "Redis": {
      "Configuration": "",
      "KeyPrefix": "community:resilience"
    }
  }
}
