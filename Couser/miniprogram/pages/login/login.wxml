<view class="login">
  <!-- 顶部品牌区 -->
  <view class="header">
    <view class="header-bg">
      <view class="decor decor-1"></view>
      <view class="decor decor-2"></view>
    </view>
    <view class="logo-wrap">
      <image class="logo-img" src="/images/logo.png" mode="aspectFit" />
      <view class="logo-text">集邻生活</view>
      <view class="logo-sub">新鲜直达 · 邻里优选</view>
    </view>
  </view>

  <!-- 登录卡片 -->
  <view class="card">
    <view class="card-title">登录</view>

    <view class="form">
      <view class="input-group">
        <view class="input-row">
          <van-icon name="phone-o" size="36rpx" color="#07c160" class="input-icon" />
          <input
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{mobile}}"
            bindinput="onInputMobile"
            class="native-input"
          />
        </view>
        <view class="input-row">
          <van-icon name="shield-o" size="36rpx" color="#07c160" class="input-icon" />
          <input
            type="number"
            maxlength="6"
            placeholder="请输入验证码"
            value="{{smsCode}}"
            bindinput="onInputCode"
            class="native-input"
          />
          <view class="code-btn-wrap">
            <view
              class="code-btn {{countdown > 0 || sending ? 'code-btn-disabled' : ''}}"
              bindtap="onSendCode"
            >{{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中…' : '获取验证码')}}</view>
          </view>
        </view>
      </view>

      <van-button
        type="primary"
        block
        round
        bind:tap="onSubmit"
        custom-class="login-btn"
      >登 录</van-button>

      <view class="form-footer">
        <text>未注册的手机号将自动创建账号 · 登录即表示同意《用户协议》和《隐私政策》</text>
      </view>
    </view>
  </view>

</view>
