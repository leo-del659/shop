.add-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.form-card {
  margin: -60rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 0 28rpx;
  position: relative;
  z-index: 2;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  flex-shrink: 0;
}
.label.required::after {
  content: '*';
  color: var(--danger);
  margin-left: 6rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
}
.input::placeholder {
  color: var(--muted);
}
.picker {
  flex: 1;
}
.picker-text {
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
}
.upload-item {
  align-items: flex-start;
  flex-direction: column;
  gap: 16rpx;
}
.upload-box {
  width: 240rpx;
  height: 240rpx;
  border-radius: 20rpx;
  background: var(--surface-variant);
  border: 2rpx dashed var(--line-strong);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.upload-box.disabled {
  opacity: 0.6;
}
.upload-ico {
  font-size: 52rpx;
  line-height: 1;
}
.upload-text {
  font-size: 24rpx;
  color: var(--muted);
}
.upload-preview {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.preview-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 20rpx;
  background: var(--line);
}
.upload-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-replace {
  font-size: 24rpx;
  color: #fff;
}
.switch-item {
  justify-content: space-between;
}
.textarea-item {
  align-items: flex-start;
  flex-direction: column;
  gap: 16rpx;
}
.textarea {
  width: 100%;
  height: 160rpx;
  background: var(--surface-variant);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}
.textarea::placeholder {
  color: var(--muted);
}

.tips {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin: 0 24rpx 30rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx 40rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 50;
}
.save-btn {
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 30rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save-btn.disabled {
  opacity: 0.6;
}
.save-btn:active {
  opacity: 0.85;
}
