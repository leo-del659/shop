<view class="register">
  <!-- 品牌区 -->
  <view class="header">
    <view class="header-bg">
      <view class="decor decor-1"></view>
      <view class="decor decor-2"></view>
    </view>
    <view class="logo-wrap">
      <image class="logo-img" src="/images/logo.png" mode="aspectFit" />
      <view class="logo-text">集邻生活</view>
      <view class="logo-sub">商户端 · 供货管理</view>
    </view>
  </view>

  <!-- 注册卡片 -->
  <view class="card">
    <view class="card-title">商户注册</view>
    <view class="card-sub">手机号注册，开启供货之旅</view>

    <view class="form">
      <view class="input-group">
        <view class="input-row">
          <text class="input-icon">📱</text>
          <input
            class="native-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{phone}}"
            data-field="phone"
            bindinput="onInput"
          />
        </view>
        <view class="input-row">
          <text class="input-icon">🔑</text>
          <input
            class="native-input"
            type="number"
            maxlength="6"
            placeholder="请输入验证码"
            value="{{code}}"
            data-field="code"
            bindinput="onInput"
          />
          <view class="code-btn-wrap">
            <view
              class="code-btn {{countdown > 0 || sending ? 'code-btn-disabled' : ''}}"
              bindtap="onSendCode"
            >{{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中…' : '获取验证码')}}</view>
          </view>
        </view>
        <view class="input-row">
          <text class="input-icon">🔒</text>
          <input
            class="native-input"
            password
            placeholder="设置登录密码（不少于6位）"
            value="{{password}}"
            data-field="password"
            bindinput="onInput"
          />
        </view>
        <view class="input-row">
          <text class="input-icon">🔒</text>
          <input
            class="native-input"
            password
            placeholder="确认登录密码"
            value="{{confirmPassword}}"
            data-field="confirmPassword"
            bindinput="onInput"
          />
        </view>
      </view>

      <view class="error-wrap">
        <text wx:if="{{errorMsg}}" class="error">{{errorMsg}}</text>
      </view>

      <button class="reg-btn" bindtap="onRegister" disabled="{{submitting}}">确 认 注 册</button>

      <view class="form-footer">
        <text class="back-login-link" bindtap="goBack">已有账号？返回登录</text>
      </view>
    </view>
  </view>
</view>
