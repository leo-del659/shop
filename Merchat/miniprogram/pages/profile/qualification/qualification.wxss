.qual-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.list-card,
.form-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 0 28rpx;
}
.list-card {
  margin-top: 24rpx;
  position: relative;
  z-index: 2;
}
.section-head {
  padding: 28rpx 0 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-ico {
  font-size: 60rpx;
}
.empty-txt {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 12rpx;
}
.qual-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.qual-item:last-child {
  border-bottom: none;
}
.qual-img-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--surface-variant);
}
.qual-img-wrap.qual-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-variant);
  border: 2rpx dashed var(--line);
}
.qual-img-fallback {
  font-size: 40rpx;
}
.qual-img {
  width: 120rpx;
  height: 120rpx;
}
.qual-main {
  flex: 1;
  min-width: 0;
}
.qual-type {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}
.qual-no,
.qual-date {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.qual-status {
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-light);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.qual-status.disabled {
  color: var(--danger);
  background: var(--danger-bg);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.form-item:last-child {
  border-bottom: none;
}
.form-item.upload-item {
  align-items: flex-start;
  padding: 28rpx 0 32rpx;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
}
.input.picker {
  color: var(--muted);
}
.input.picker.has-value {
  color: var(--text);
}
.input::placeholder {
  color: var(--muted);
}

.upload-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}
.upload-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--line-strong);
  background: var(--surface-variant);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.upload-box.has-img {
  border-style: solid;
  border-color: var(--line);
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.upload-ico {
  font-size: 48rpx;
}
.upload-txt {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
.upload-preview {
  width: 200rpx;
  height: 200rpx;
}
.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer {
  padding: 0 24rpx;
}
.save-btn {
  background: linear-gradient(135deg, var(--brand), var(--brand-dark));
  color: #fff;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 30rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save-btn.disabled {
  opacity: 0.6;
}
.save-btn:active {
  opacity: 0.85;
}
