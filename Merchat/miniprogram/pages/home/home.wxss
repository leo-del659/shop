/* 首页样式：色值全部引用 app.wxss 令牌 */

/* 顶部浅蓝区域：承载消息按钮 + 商户信息 + 经营数据，与下方大卡片无缝衔接
   padding-top 用于把商户信息/经营数据整体下移 38px；绝对定位的消息按钮以 padding 盒为基准，
   内边距不改变其定位原点，因此消息按钮位置保持不变 */
.home {
  background: var(--page-bg);
}
.top-area {
  position: relative;
  background: linear-gradient(180deg, #dbe7fb 0%, #eaf1fd 65%, #f3f7fe 100%);
  padding-top: 38px;
  padding-bottom: 8rpx;
}
/* 消息按钮：独立容器，绝对定位在胶囊正下方（top/right 由 JS 内联注入）
   注意：此容器位置独立于下方内容，调整页面其他间距时不要改动它，消息按钮须保持在胶囊下方 */
.top-actions {
  position: absolute;
  z-index: 3;
  display: flex;
}
/* 商户信息 + 经营数据：整体下移
   用 top-area 的 padding-top 而非子元素 margin-top，避免外边距折叠把 top-area 整体下移、
   导致绝对定位的消息按钮跟着偏移 */
.merchant-panel {
  position: relative;
  z-index: 1;
}
.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}
/* 按钮：无底无框，直接浮于蓝渐变背景，去除白框；保留点击区域 */
.hero-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 80rpx;
  padding: 8rpx 16rpx;
  background: transparent;
  border: none;
  border-radius: 20rpx;
}
.hero-action-hover {
  opacity: 0.75;
}
/* 消息按钮相对定位，用于挂未读红点 */
.hero-action-msg {
  position: relative;
}
/* 未读红点 */
.hero-action-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fa3534;
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  border: 2rpx solid #fff;
}
/* 消息按钮图标（images/msg-icon.png，透明底深色气泡） */
.hero-action-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.hero-action-text {
  font-size: 20rpx;
  color: var(--text);
  line-height: 1.2;
}
.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-chips {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}
.chip {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}
.chip-level {
  background: var(--brand);
  color: #ffffff;
  margin-right: 8rpx;
}
.chip-status {
  background: var(--brand-light);
  color: var(--brand-dark);
  border: 1rpx solid var(--brand);
  font-weight: 500;
}

/* 经营数据：无卡片样式，直接置于浅蓝背景上 */
.kpi-block {
  padding: 20rpx 0 24rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(51, 51, 51, 0.07);
}
.kpi-grid {
  display: flex;
  align-items: stretch;
}
.kpi-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-radius: 16rpx;
  padding: 8rpx 0;
}
.kpi-hover {
  opacity: 0.7;
}
.kpi-divider {
  width: 1rpx;
  background: rgba(51, 51, 51, 0.12);
  margin: 8rpx 0;
}
.kpi-label {
  font-size: 26rpx;
  color: var(--muted);
  font-weight: 500;
}
.kpi-num {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.1;
}
.kpi-num.warn {
  color: var(--danger);
}
.kpi-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.kpi-error {
  text-align: center;
}
.btn-retry {
  margin: 20rpx auto 0;
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}
.btn-press {
  opacity: 0.85;
}

/* 下方大卡片：公告 + 最新订单 + 在售商品合并为一张，占满下方区域 */
.main-card {
  /* 毛玻璃面板：半透明白 + 模糊 + 高光顶边 + 圆角顶边 + 轻蓝投影 */
  background: rgba(255, 255, 255, 0.66);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 32rpx 32rpx 0 0;
  /* 不再强制 min-height:100vh（内容少时会留出大片空白），按内容高度自适应；
     底部内边距用于让开自定义 TabBar（110rpx + 安全区） */
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(43, 87, 190, 0.10);
}
.main-sec {
  padding: 24rpx;
}
.main-divider {
  height: 1rpx;
  background: var(--line);
  margin: 0 24rpx;
}

/* 动态通知内容（位于大卡片首个分区）：多条循环切换、单条超长时条内横向滚动 */
.notice-sec {
  display: flex;
  align-items: center;
}
.nm-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.nm-viewport {
  flex: 1;
  height: 40rpx;
  overflow: hidden;
}
.nm-text {
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 0.35s ease;
}
/* 切换通知：仅淡入淡出，不改 transform，避免与横向滚动动画冲突 */
.nm-text.out {
  opacity: 0;
}
.nm-text.in {
  opacity: 0;
  transition: none;
}
/* 内容过长时条内横向滚动 */
.nm-text.scroll {
  display: inline-block;
  animation: nm-marquee 14s linear infinite;
}
@keyframes nm-marquee {
  0% {
    transform: translateX(100%);
  }
  100% {
    transform: translateX(-100%);
  }
}
.nm-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.sk {
  background: rgba(51, 51, 51, 0.07);
  border-radius: 8rpx;
  animation: sk-pulse 1.2s ease-in-out infinite;
}
.sk-label {
  width: 120rpx;
  height: 24rpx;
}
.sk-num {
  width: 140rpx;
  height: 40rpx;
  margin-top: 16rpx;
}
@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

.error-text {
  font-size: 26rpx;
  color: var(--muted);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.more {
  font-size: 26rpx;
  color: var(--brand);
}
.more-hover {
  opacity: 0.7;
}

.order-list {
  margin-top: 8rpx;
}
.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
}
.order-item + .order-item {
  border-top: 1rpx solid var(--line);
}
.order-hover {
  opacity: 0.7;
}
.order-main {
  flex: 1;
  min-width: 0;
}
.order-no {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.order-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 24rpx;
}
.order-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.order-side .tag {
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  padding: 40rpx 0;
  font-size: 26rpx;
}

/* 商品横滑：左右出血到卡片边缘，与标题左对齐 */
.goods-scroll {
  white-space: nowrap;
  margin-top: 16rpx;
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.goods-card {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  /* 轻玻璃：半透明白 + 蓝调描边 + 柔和阴影（横滑列表不叠模糊，保证滚动流畅） */
  background: rgba(255, 255, 255, 0.72);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-right: 16rpx;
  vertical-align: top;
  box-shadow: 0 4rpx 16rpx rgba(43, 87, 190, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.goods-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 20rpx rgba(59, 111, 224, 0.12);
}
.goods-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--surface-variant), var(--line));
  display: block;
  margin: 0 auto;
}
.goods-emoji {
  font-size: 56px;
  text-align: center;
  width: 168rpx;
  height: 168rpx;
  line-height: 168px;
  margin: 0 auto;
  background: linear-gradient(135deg, var(--surface-variant), var(--line));
  border-radius: 16rpx;
}
.goods-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
}
.goods-price {
  font-size: 30rpx;
  color: var(--brand);
  font-weight: 700;
  margin-top: 8rpx;
}
.goods-stock {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: var(--muted);
}
